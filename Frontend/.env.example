# TaskFlow Environment Configuration
# Set to 'false' when connecting to real Flask + MySQL backend
VITE_USE_MOCK_API=true

# Real backend Flask API URL (defaults to http://localhost:5000/api)
VITE_API_BASE_URL=http://localhost:5000/api

# Admin registration authorization access code (optional: set your custom code)
VITE_ADMIN_ACCESS_CODE=
