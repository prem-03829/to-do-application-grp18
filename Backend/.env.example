# Copy this file to .env (never push .env to GitHub).
# MySQL (use the details for Prem's database). If you skip DATABASE_URL, a local SQLite file is used for quick testing.
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/todo_db
JWT_SECRET_KEY=change-this-to-a-long-random-string

# Admin account that is created automatically the first time the backend starts
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=Admin@123
